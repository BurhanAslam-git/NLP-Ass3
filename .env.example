# --- LLM (Ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=300
REQUEST_TIMEOUT_SECONDS=120
MAX_CONTEXT_TOKENS=3072

# --- RAG ---
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.30
RAG_MAX_CHARS=800
RAG_CHROMA_DIR=data/chroma_db
RAG_DOCUMENTS_DIR=data/documents
RAG_COLLECTION=library_v1
RAG_CACHE_SIZE=256
EMBEDDING_MODEL=models/all-MiniLM-L6-v2
SUMMARISE_AUTO_THRESHOLD=0.95

# --- Voice: speech-to-text ---
MODELS_DIR=models
ASR_MODEL=tiny.en
ASR_COMPUTE_TYPE=int8
ASR_CPU_THREADS=4
VAD_THRESHOLD=0.5
VAD_SILENCE_MS=600
ASR_PARTIAL_INTERVAL_MS=1000
ASR_MAX_UTTERANCE_S=20

# --- Voice: text-to-speech ---
TTS_VOICE=en_US-lessac-low
TTS_FIRST_CHUNK_MIN_WORDS=6

# --- Tools ---
TOOL_TIMEOUT_SECONDS=3
TOOL_MAX_ROUNDS=2
